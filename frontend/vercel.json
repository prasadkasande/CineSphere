{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://api.cinesphere.prasadkasande.uk/api/:path*" },
    { "source": "/uploads/:path*", "destination": "https://api.cinesphere.prasadkasande.uk/uploads/:path*" },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
