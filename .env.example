# ============================================================
# Production environment variables (set these on Railway, not in a file).
# Spring's relaxed binding maps each name onto the matching property, so
# nothing here needs to appear in application.properties.
# ============================================================

# Activates src/main/resources/application-prod.properties
SPRING_PROFILES_ACTIVE=prod

# Postgres. On Railway these are reference variables pointing at the
# Postgres service, e.g. SPRING_DATASOURCE_URL=jdbc:postgresql://${{Postgres.PGHOST}}:${{Postgres.PGPORT}}/${{Postgres.PGDATABASE}}
SPRING_DATASOURCE_URL=jdbc:postgresql://host:5432/railway
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=

# JWT signing key. Must be at least 256 bits (32+ chars). Generate with:
#   openssl rand -base64 48
APP_JWT_SECRET=

# Origin of the deployed frontend, comma-separated for more than one.
APP_CORS_ALLOWED_ORIGINS=https://your-app.vercel.app

# Where cover images are written. Must match the mounted volume path.
APP_UPLOAD_DIR=/app/uploads

# First-run admin account.
APP_SEED_ADMIN_EMAIL=admin@movieticket.com
APP_SEED_ADMIN_PASSWORD=
