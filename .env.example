# Copy to .env beside docker-compose.prod.yml on the VPS and fill in.
# chmod 600 .env - it holds live credentials.

# Postgres. Any strong random string; only ever used inside the compose network.
DB_USERNAME=cinesphere
DB_PASSWORD=

# JWT signing key. Must be 64+ bytes - ProductionSecretsCheck refuses to start
# the prod profile on anything shorter, or on the default committed to the repo.
#   openssl rand -base64 48
APP_JWT_SECRET=

# First-run admin account. The password must not be the repo's default either.
APP_SEED_ADMIN_EMAIL=admin@movieticket.com
APP_SEED_ADMIN_PASSWORD=
